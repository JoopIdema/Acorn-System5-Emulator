#include <winver.h>
1 ICON "app.ico"
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "Acorn System 5 Emulator"
      VALUE "FileDescription", "Acorn System 5 Emulator"
      VALUE "FileVersion", "1.1.0"
      VALUE "ProductVersion", "1.1.0"
      VALUE "OriginalFilename", "system5.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
